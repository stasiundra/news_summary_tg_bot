# Telegram Bot
BOT_TOKEN=

# Telegram user-account API credentials (for Telethon scraping).
# Leave TG_API_ID empty to use web-scraping mode (t.me/s/...) instead of Telethon.
TG_API_ID=
TG_API_HASH=

# Google Gemini API key (free tier: 15 rpm, 1500 req/day)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model for digest generation and Q&A.
# Options: gemini-3.6-flash (default, free), gemini-flash-latest
GEMINI_MODEL=gemini-3.6-flash

# Owner Telegram ID (whitelist gate for bot commands)
OWNER_ID=

# Web panel auth — password required to access /digest, /channels, /users.
# Generate a long random string. Required for production.
WEB_AUTH_TOKEN=

# Web panel bind host. Default 127.0.0.1 (loopback only — use reverse proxy for remote).
WEB_BIND_HOST=127.0.0.1

# Web panel port
WEB_PORT=8080