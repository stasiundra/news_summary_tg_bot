# Telegram Bot
BOT_TOKEN=

# Telegram user-account API credentials (for Telethon scraping).
# Leave TG_API_ID empty to use web-scraping mode (t.me/s/...) instead of Telethon.
TG_API_ID=
TG_API_HASH=

# --- LLM backend ---
# Основной провайдер: ollama (default) или gemini
LLM_PROVIDER=ollama
# Резервные провайдеры через запятую (пусто — без резерва)
LLM_FALLBACK_PROVIDERS=gemini
# Таймаут одного запроса к LLM, секунды
LLM_TIMEOUT_S=300

# Ollama: локальный демон (http://127.0.0.1:11434).
# Для облака ollama.com укажи https://ollama.com и OLLAMA_API_KEY (ключ из подписки).
# Модель должна быть доступна аккаунту: `ollama pull deepseek-v4.1-flash:cloud`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
# false — не показывать reasoning-цепочку моделей с "thinking"
OLLAMA_THINK=false

# Gemini (резервный провайдер; free tier: 15 rpm, 1500 req/day)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Owner Telegram ID (whitelist gate for bot commands)
OWNER_ID=

# Web panel auth — password required to access /digest, /channels, /users.
# Generate a long random string. Required for production.
WEB_AUTH_TOKEN=

# Web panel bind host. Default 127.0.0.1 (loopback only — use reverse proxy for remote).
WEB_BIND_HOST=127.0.0.1

# Web panel port
WEB_PORT=8080
